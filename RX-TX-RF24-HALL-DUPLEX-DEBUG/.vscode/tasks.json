{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "RF24: abrir os dois monitores",
            "dependsOn": [
                "RF24: monitor usbserial-120",
                "RF24: monitor usbserial-130"
            ],
            "dependsOrder": "parallel",
            "problemMatcher": []
        },
        {
            "label": "RF24: monitor usbserial-120",
            "type": "process",
            "command": "${env:HOME}/.platformio/penv/bin/pio",
            "args": ["device", "monitor", "--port", "/dev/cu.usbserial-120", "--baud", "115200"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "group": "rf24-monitores",
                "showReuseMessage": false
            },
            "problemMatcher": []
        },
        {
            "label": "RF24: monitor usbserial-130",
            "type": "process",
            "command": "${env:HOME}/.platformio/penv/bin/pio",
            "args": ["device", "monitor", "--port", "/dev/cu.usbserial-130", "--baud", "115200"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "group": "rf24-monitores",
                "showReuseMessage": false
            },
            "problemMatcher": []
        }
    ]
}
