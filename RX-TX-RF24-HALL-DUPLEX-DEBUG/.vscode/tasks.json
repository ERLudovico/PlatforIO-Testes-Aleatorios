{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "RF24: abrir os dois monitores",
            "type": "process",
            "command": "/usr/bin/python3",
            "args": [
                "${workspaceFolder}/.vscode/open_rf24_monitors.py"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "silent",
                "focus": false,
                "panel": "dedicated",
                "showReuseMessage": false,
                "close": true
            },
            "runOptions": {
                "instanceLimit": 1
            },
            "problemMatcher": []
        }
    ]
}
